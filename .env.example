# Real environment variables this app actually reads (api/*.js and
# scripts/setup-database.js). Set each of these in Vercel → Settings →
# Environment Variables — this file is just a reference, Vercel doesn't
# read it directly.

# Neon Postgres connection string (use the "pooled" connection string
# Neon gives you). Powers every real database read/write: members,
# bookings, tickets.
DATABASE_URL="postgresql://..."

# Stripe secret key (starts with sk_live_ or sk_test_) — used to create
# real PaymentIntents at checkout.
STRIPE_SECRET_KEY="sk_live_..."

# Stripe webhook signing secret (starts with whsec_), from the webhook
# endpoint you create in the Stripe Dashboard pointing at
# /api/stripe-webhook. This is what lets that endpoint trust that a
# payment-succeeded event genuinely came from Stripe.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend API key (starts with re_) — sends every outgoing email:
# customer receipts, admin booking alerts, password resets, renewal
# reminders.
RESEND_API_KEY="re_..."

# Comma-separated email address(es) that get a "someone just booked"
# alert the instant a payment succeeds, e.g.
# "owner@example.com,manager@example.com"
ADMIN_NOTIFY_EMAILS="owner@example.com"

# Shared password protecting the staff-only /checkin and /members pages,
# and the manual/dry-run trigger for the renewal-reminder job. Pick
# something only staff know.
ADMIN_PASSWORD="choose-a-real-password"

# Proves the daily renewal-reminder cron job (see
# api/send-renewal-reminders.js and the "crons" entry in vercel.json) is
# really being triggered by Vercel and not by anyone who finds the URL.
# Any random string — Vercel sends it back automatically as
# "Authorization: Bearer <this value>" on the scheduled invocation.
CRON_SECRET="choose-a-random-string"

# Optional — only needed if you've set up the ntfy.sh app for instant
# phone push notifications on new bookings. Leave unset to skip this.
NTFY_TOPIC=""
